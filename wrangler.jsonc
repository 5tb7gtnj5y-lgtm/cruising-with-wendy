{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cruising-with-wendy",
  "account_id": "80320ac2d42d2bfe819d26fc24290d7b",
  "main": "worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "SITE_PUBLIC": "true",
    "ACCESS_MODE": "public",
    "SITE_ORIGIN": "https://cruising-with-wendy.kmvbcbwmw2.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cruising-with-wendy",
      "database_id": "2054652f-238d-4698-9bcf-83483e977b7d",
      "migrations_dir": "drizzle"
    }
  ],
  "triggers": {
    "crons": [
      "0 */3 * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "run_worker_first": true,
    "binding": "ASSETS"
  }
}
