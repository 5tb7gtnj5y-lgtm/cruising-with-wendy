{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cruising-with-wendy",
  "main": "worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "SITE_PUBLIC": "false",
    "ACCESS_MODE": "private",
    "SITE_ORIGIN": "https://example.invalid"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cruising-with-wendy",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "triggers": {
    "crons": [
      "0 */3 * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "run_worker_first": true,
    "binding": "ASSETS"
  }
}
